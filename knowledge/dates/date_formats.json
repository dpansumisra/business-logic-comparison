    {
      "record_id": "FMT_RFC_3339_TIMESTAMP",
      "concept_id": "CONCEPT_TIMESTAMP_INSTANT",
      "name": "RFC 3339 UTC Timestamp",
      "pattern": "YYYY-MM-DDTHH:mm:ss.sssZ",
      "components": [
        { "component": "date", "position": 1, "length": 10 },
        { "component": "time", "position": 12, "length": 8 },
        { "component": "fraction", "position": 20, "length": 4 },
        { "component": "timezone", "position": 24, "length": 1 }
      ],
      "example": "2026-11-16T12:00:00.000Z",
      "interpretation": {
        "calendar": "proleptic_gregorian",
        "timezone": "UTC",
        "precision": "millisecond"
      },
      "ambiguity": {
        "is_ambiguous": false,
        "reason": "Explicit UTC indicator Z."
      },
      "canonical_representation": "2026-11-16T12:00:00.000Z",
      "validation_rules": [
        "Valid ISO date part",
        "Time part HH 00-23, mm 00-59, ss 00-60 (leap seconds permitted)",
