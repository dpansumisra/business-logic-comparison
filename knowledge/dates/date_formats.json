{
  "dataset_id": "DATE_FORMATS_001",
  "version": "1.0.0",
  "records": [
    {
      "record_id": "FMT_ISO_8601_DATE",
      "concept_id": "CONCEPT_CALENDAR_DATE",
      "name": "ISO 8601 Extended Calendar Date",
      "pattern": "YYYY-MM-DD",
      "components": [
        { "component": "year", "position": 1, "length": 4 },
        { "component": "month", "position": 6, "length": 2 },
        { "component": "day", "position": 9, "length": 2 }
      ],
      "example": "2026-11-16",
      "interpretation": {
        "calendar": "proleptic_gregorian",
        "locale": "universal",
        "year_digits": 4,
        "century_policy": "explicit_four_digit"
      },
      "ambiguity": {
        "is_ambiguous": false,
        "reason": "Unambiguous international standard format (ISO 8601/RFC 3339)."
      },
      "canonical_representation": "2026-11-16",
      "validation_rules": [
        "Year must be 4 digits",
        "Month must be 01 to 12",
        "Day must be valid for month and leap year rules"
      ],
      "related_concepts": ["FMT_YYYYMMDD_COMPACT", "FMT_RFC_3339_TIMESTAMP"],
      "source_references": ["SRC_RFC_3339"]
    },
    {
      "record_id": "FMT_DDMMYY",
      "concept_id": "CONCEPT_CALENDAR_DATE",
      "name": "Day Month Year Two-Digit",
      "pattern": "ddMMyy",
      "components": [
        { "component": "day", "position": 1, "length": 2 },
        { "component": "month", "position": 3, "length": 2 },
        { "component": "year", "position": 5, "length": 2 }
      ],
      "example": "290224",
      "interpretation": {
        "calendar": "gregorian",
        "locale": "en-GB",
        "year_digits": 2,
        "century_policy": "requires_explicit_pivot"
      },
      "ambiguity": {
        "is_ambiguous": true,
        "reason": "Two-digit years require century interpretation pivot; conflicting order with MMDDYY."
      },
      "canonical_representation": "2024-02-29",
      "validation_rules": [
        "Day must be valid for month and year",
        "Month must be between 1 and 12",
        "Century pivot rule (e.g. SAS YEARCUTOFF or Python %y 1969-2068) must be explicitly verified"
      ],
      "related_concepts": ["FMT_MMDDYY", "FMT_YYYYMMDD_COMPACT"],
      "source_references": ["SRC_UNICODE_CLDR"]
    },
    {
      "record_id": "FMT_MMDDYY",
      "concept_id": "CONCEPT_CALENDAR_DATE",
      "name": "Month Day Year Two-Digit",
      "pattern": "MMddyy",
      "components": [
        { "component": "month", "position": 1, "length": 2 },
        { "component": "day", "position": 3, "length": 2 },
        { "component": "year", "position": 5, "length": 2 }
      ],
      "example": "022924",
      "interpretation": {
        "calendar": "gregorian",
        "locale": "en-US",
        "year_digits": 2,
        "century_policy": "requires_explicit_pivot"
      },
      "ambiguity": {
        "is_ambiguous": true,
        "reason": "Confuses with DDMMYY when day <= 12."
      },
      "canonical_representation": "2024-02-29",
      "validation_rules": [
        "Month must be 1-12",
        "Day must be 1-31 depending on month"
      ],
      "related_concepts": ["FMT_DDMMYY"],
      "source_references": ["SRC_UNICODE_CLDR"]
    },
    {
